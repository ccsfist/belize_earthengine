// Calculate standardized precipitation index over rolling window

var spi = function(dataset,interval,increment,year_start,year_end,windowWidth) {

  // dataset: string; satellite to use ["CHIRPS","GPM"]
  // increment: string; unit of time ['day','week','month']
  // interval: integer; number of [increment] to advance by
  // year_start: integer; first calendar year for calculation
  // year_end: integer; last calendar year for calculation
  // windowWidth: integer; number of [increment] before and after each observation to compute SPI
    
  var rawData = rainfallDatasets[dataset] ;
  var years_list = ee.List.sequence(year_start,year_end) ;
  var start = '2018-01-01';
  var startDate = ee.Date(start);
  var secondDate = startDate.advance(interval, increment).millis();
  var increase = secondDate.subtract(startDate.millis());
  var interval_list = ee.List.sequence(startDate.millis(), ee.Date('2019-01-01').millis(), increase);
 
  var byInterval = ee.ImageCollection(
    ee.FeatureCollection(years_list.map(function (y) {
        var yearCollection = rawData.filter(ee.Filter.calendarRange(y, y, 'year'));
          var byYear = ee.ImageCollection.fromImages(
            interval_list.map(function (inv) {
              var summedImage = yearCollection.filter(ee.Filter.calendarRange
                (ee.Date(inv).getRelative('day','year'), 
                 ee.Date(inv).advance(interval, increment).getRelative('day','year'))
                  )
                .reduce(ee.Reducer.sum());
              
              var doy = ee.Date(inv).getRelative('day','year').add(ee.Number(1)) ;
              var moy = ee.Date(inv).getRelative('month','year').add(ee.Number(1)) ; 
              var dom = ee.Date(inv).getRelative('day','month').add(ee.Number(1)) ;
              
              return summedImage
                .set('day_of_year', doy)
                .set('year',y)
                .set('system:time_start', ee.Date.fromYMD(y, moy, dom).millis()) ;
            }));
      return byYear;
    }))
  .flatten()); 
  
  var means = ee.ImageCollection(interval_list
    .map(function(date) {
      return byInterval.filter(ee.Filter.calendarRange
      (ee.Date(date).advance(-1*windowWidth,increment).getRelative('day','year'), 
      ee.Date(date).advance(windowWidth, increment).getRelative('day','year')))
          .mean()
          .set('day_of_year', ee.Date(date).getRelative('day','year').add(ee.Number(1)) );
  }));
  
  var std_devs = ee.ImageCollection(interval_list
    .map(function(date) {
      return byInterval.filter(ee.Filter.calendarRange
      (ee.Date(date).advance(-1*windowWidth,increment).getRelative('day','year'), 
      ee.Date(date).advance(windowWidth, increment).getRelative('day','year')))
          .reduce(ee.Reducer.stdDev())
          .set('day_of_year', ee.Date(date).getRelative('day','year').add(ee.Number(1)) );
  }));
  
    var anomaly = ee.ImageCollection(
    ee.FeatureCollection(years_list.map(function (y) {
        var yearCollection = byInterval.filter(ee.Filter.calendarRange(y, y, 'year'));
          var byYear = ee.ImageCollection.fromImages(
            interval_list.map(function (inv) {
              
              var doy = ee.Date(inv).getRelative('day','year').add(ee.Number(1)) ;
              var moy = ee.Date(inv).getRelative('month','year').add(ee.Number(1)) ; 
              var dom = ee.Date(inv).getRelative('day','month').add(ee.Number(1)) ;
              
              var anomalyImage = yearCollection.filter(ee.Filter.calendarRange
                  (ee.Date(inv).advance(-1*windowWidth,increment).getRelative('day','year'), 
                  ee.Date(inv).advance(windowWidth, increment).getRelative('day','year')))
              .mean()
              .subtract(means.filter(ee.Filter.eq('day_of_year',doy)).first())
              .divide(std_devs.filter(ee.Filter.eq('day_of_year',doy)).first()) ;
              
              return anomalyImage
                .set('day_of_year', doy)
                .set('year',y)
                .set('system:time_start', ee.Date.fromYMD(y, moy, dom).millis()) ;
            }));
      return byYear;
    }))
  .flatten()); 
  
  return anomaly ;
  
} ;


// Calculate seasonal total rainfall or SPI over a given season

var seasonalTotal = function(intervalDataset,seasonStartDoy,seasonLength,year_start,year_end) {
  
  // intervalDataset: output from rainfallIntervalSum or spi
  // seasonStartDoy: integer; day of year which defines beginning of agricultural year  
  // seasonLength: length of season, in days
  // year_start: integer; first calendar year for calculation
  // year_end: integer; last calendar year for calculation
  
  var years_list = ee.List.sequence(year_start,year_end) ;
  
  var bySeason = ee.ImageCollection(
  years_list.map(function(year) {
    
    var firstDoy = ee.Date.fromYMD(year,1,1) ;
    var startDate = firstDoy.advance(seasonStartDoy-1,'day') ; // start date of ag year
    var endDate = startDate.advance(seasonLength,'day') ; // end date of ag year
    
    var oneYear = intervalDataset
      .filterDate(startDate,endDate)
      .sum(); 
    return oneYear.set('year', ee.String(year)) ;
  })) ;
  
  return bySeason ; 
  
} ;

// calculate seasonal totals from station (point feature) data

var seasonalTotalPoint = function(inputDataset,precName,seasonStartDoy,seasonLength,year_start,year_end) {
  
  // inputDataset: feature collection of point data
  // precName: name of precipitation property
  // seasonStartDoy: integer; day of year which defines beginning of agricultural year  
  // seasonLength: length of season, in days
  // year_start: integer; first calendar year for calculation
  // year_end: integer; last calendar year for calculation
  
  var years_list = ee.List.sequence(year_start,year_end) ;
  
  var bySeason = ee.FeatureCollection(
  years_list.map(function(year) {
    
    var firstDoy = ee.Date.fromYMD(year,1,1) ;
    var startDate = firstDoy.advance(seasonStartDoy-1,'day') ; // start date of ag year
    var endDate = startDate.advance(seasonLength,'day') ; // end date of ag year
    
    var geom = inputDataset.first().geometry()
    
    var oneYear = inputDataset
      .filterDate(startDate,endDate)
      .reduceColumns(ee.Reducer.sum(),[precName]); 
    return ee.Feature(geom,oneYear).set('year', ee.String(year)).set('id',1) ;
  })) ;
  
  return bySeason ; 
  
} ;

