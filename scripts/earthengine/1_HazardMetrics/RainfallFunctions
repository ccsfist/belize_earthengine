          var startDate = firstDoy.advance(season_start_day-1,'day') ; // start date of ag year
          var endDate = startDate.advance(season_length,'day') ; // end date of ag year
        
          var yearCollection = chirps.filterDate(startDate,endDate);
            var byYear = ee.ImageCollection(yearCollection.iterate(
              function (image, acc) {
                image = ee.Image(image).set('year',ee.String(y)) ;
                acc = ee.ImageCollection(acc)
                var last = ee.Image(acc.get('last'))
                var value = last
                  .add(image)
                  .unmask(last)
                  .copyProperties(image, image.propertyNames())
                return acc
                  .merge(ee.ImageCollection([value]))
                  .set('last', value)
                  
                  
              },
            ee.ImageCollection([]).set('last', ee.Image(0).rename('precip'))
          )
        );
        return byYear;
      }))
    .flatten());

 // compute historical trigger percentile
  
  var percentiles = ee.ImageCollection(
        clim_years.map(function (y) {
         var yearTotal = climatology
          .filter(ee.Filter.eq('year',ee.String(y)))
          .sort('system:time_start',false)
          .first()
       
       return(yearTotal) ;
  
    })).reduce(ee.Reducer.percentile([20])).rename('trigger');

  var percentilesAll = ee.ImageCollection(
        clim_years.map(function (y) {
         var yearTotal = climatology
          .filter(ee.Filter.eq('year',ee.String(y)))
          .sort('system:time_start',false)
          .first()
       
       return(yearTotal) ;
  
    })).reduce(ee.Reducer.percentile(ee.List.sequence(10,100,10))) ;
    
    var bands = percentilesAll.bandNames()
    var list = bands.map(function(n) { return percentilesAll.select([n]) })
    var percentilesAll = ee.ImageCollection.fromImages(list).map(function(n){
      var index = n.get('system:index')
      return n.set('index_num',ee.Number(index))
    }) ;

  // compute climatological prob. of non-exceedence
  
  var climExceedence = ee.ImageCollection(
        clim_years.map(function (y) {
         var yearTotal = climatology
          .filter(ee.Filter.eq('year',ee.String(y)))
          .sort('system:time_start',false)
          .first()
        
        var zero = ee.Image(0)
        var one = ee.Image(1)
        
        var output = zero.where(yearTotal.lt(percentiles),one) ;
            
        return output.set('year',ee.String(y));
  
    }));
  
  var climExeedenceProb = climExceedence.mean().rename(['climProb'])
  
  
  // compute forecast confidence interval
  
  var forecastUpper = forecast.add((forecast_var.sqrt()).multiply(1)).rename(['forecastUpper']) ;
  var forecastLower = forecast.subtract((forecast_var.sqrt()).multiply(1)).rename(['forecastLower']) ;
  
  // compute forecast trigger PoNE
  
  var forecastZ = percentiles.subtract(forecast).divide(forecast_var.sqrt())
  function eeCdf(z) {
    return ee.Image(0.5)
        .multiply(ee.Image(1).add(ee.Image(z).divide(ee.Image(2).sqrt()).erf()));
  } 
  var forecastTrigProb = eeCdf(forecastZ).rename('forecastTrigProb') ;
  
  // compute conditional prob. of non-exceedence given rainfall so far
  /// NOTE: we are defining analog years at the spatial aggregate level, not pixel-wise.
  /// this is for ease / speed of computation. may change this in the future.
  
  var monFirstDoy = ee.Date.fromYMD(monitor_year,1,1) ;
  var monStartDate = monFirstDoy.advance(season_start_day-1,'day') ; // start date of ag year
  var monEndDate = monStartDate.advance(season_length,'day') ; // end date of ag year
  
  var monitor_start = monStartDate 
  var monitor_latest = monEndDate 
  
  var currentData = monitor_data.filterDate(monitor_start,monitor_latest)
  
  var currentCum =  ee.ImageCollection(currentData.iterate(
              function (image, acc) {
                image = ee.Image(image)
                acc = ee.ImageCollection(acc)
                var last = ee.Image(acc.get('last'))
                var value = last
                  .add(image)
                  .unmask(last)
                  .copyProperties(image, image.propertyNames())
                return acc
                  .merge(ee.ImageCollection([value]))
                  .set('last', value)
                  
                  
              },
            ee.ImageCollection([]).set('last', ee.Image(0).rename('precip'))
  ))
  
  
  var currentTotal = currentCum
          .sort('system:time_start',false)
          .max()
          
  var latestTotal = currentTotal.reduceRegion({
        geometry:selected,
        crs:"EPSG:4326",
        crsTransform:[5/60,0,0,0,5/60,0], // 5 arcmin resolution grid
        bestEffort:true, 
        reducer:ee.Reducer.mean()
      }).get("precip") ;
  
  var range = currentData.reduceColumns(ee.Reducer.minMax(), ["system:time_start"]) ;
  var latestDataDate = ee.Date(range.get('max')) ;
  var days_so_far = latestDataDate.difference(monStartDate,'days') ;
  
  var analogYears = ee.ImageCollection(
        clim_years.map(function (y) {
          
        var firstDoy = ee.Date.fromYMD(y,1,1) ;
        var startDate = firstDoy.advance(season_start_day-1,'day') ; // start date of ag year
        var endDate = startDate.advance(season_length,'day') ; // end date of ag year
        
        var latestDate = startDate.advance(days_so_far,'day') ;
        
        var firstDate = startDate ;  
        
        var lastDate =  ee.Date(ee.Number(latestDate.millis())
           .min(ee.Number(endDate.millis()))
       ) ;
          
         var yearTotal = climatology
          .filter(ee.Filter.eq('year',ee.String(y)))
          .filterDate(firstDate,lastDate)
          .sort('system:time_start',false)
          .max()
            
        return yearTotal.set('year',ee.String(y));
  
  }));
  
  function getMaxPrecip(image){
      var maxValue = image.select("precip").reduceRegion({
        geometry:selected,
        crs:"EPSG:4326",
        crsTransform:[5/60,0,0,0,5/60,0], 
        bestEffort:true, 
        reducer:ee.Reducer.mean()
      }).get("precip");
      return image.set({
        maxprecip: maxValue
      })
  }  

  var analogYears = analogYears.map(getMaxPrecip)
      .filter(ee.Filter.rangeContains('maxprecip',ee.Number(latestTotal).subtract(50),
      ee.Number(latestTotal).add(50))) ;

  var analogYearsSeq = analogYears.aggregate_array('year')
  
  var climExceedenceCond = ee.ImageCollection(
        analogYearsSeq.map(function (y) {
         var yearTotal = climatology
          .filter(ee.Filter.eq('year',ee.String(y)))
          .sort('system:time_start',false)
          .max()
        
        var zero = ee.Image(0)
        var one = ee.Image(1)
        
        var output = zero.where(yearTotal.lt(percentiles),one) ;
            
        return output.set('year',ee.String(y));
  
    }));
  
  var climExeedenceProbCond = climExceedenceCond.mean().rename(['climProbCond'])
  
  // combine stats for visualization
  
  /// point value data
  
  var forecast = forecast.rename(['forecast']) ;
  var ts_combined = currentCum.map(function(img) {
    
    var newBands = ee.Image([forecast,forecastUpper,forecastLower,percentiles])
    
   return img.addBands(newBands)
    
  }) ;
  
  /// probability data
  
  var probsCombined = ee.Image([climExeedenceProb,climExeedenceProbCond,forecastTrigProb]) ;
  
  // plot
  
  
  var monitor_start_doy = monitor_start.getRelative('day','year') ;
  var monitor_end_doy = monitor_latest.getRelative('day','year') ;
  var maxPrecip = climatology.max().reduceRegion(ee.Reducer.mean(),selected).get('precip');
  var maxPrecip = ee.Number(maxPrecip).add(50) ;

  function chartClim(point) {
  
    var chart =  ui.Chart.image.doySeriesByYear({
        bandName: 'precip',
        imageCollection: climatology.filter(ee.Filter.inList('year',analogYearsSeq)), 
        region: point, 
        regionReducer: ee.Reducer.mean(), 
        scale: 1000
      }).setOptions({
        title:'Historical Years w/ This Much Rain to Date',
        hAxis:{viewWindow:{min:monitor_start_doy,max:monitor_end_doy}}, 
        vAxis:{viewWindow:{min:0,max:maxPrecip.getInfo()},title:'Cumulative rainfall (mm)'}
      
      }) ;
    
    return chart ;
  
  }
  
  
  function chartCurrent(point) {
  
    
    var chart =  ui.Chart.image.doySeries({
        imageCollection: ts_combined, 
        region: point, 
        regionReducer: ee.Reducer.mean(), 
        scale: 1000
      })
      .setSeriesNames(['Fcast lower bound','Fcast upper bound','Fcast','Current season',"Trig. threshold"])
      .setOptions({
        title:'Forecast & Rainfall So Far This Year',
        hAxis:{viewWindow:{min:monitor_start_doy,max:monitor_end_doy}}, 
        vAxis:{viewWindow:{min:0,max:maxPrecip.getInfo()},title:'Cumulative rainfall (mm)'}
      
      })
    
    return chart ;
  
  }
  
  function chartProb(point) {
  
    
    var chart =  ui.Chart.image.histogram({
        image: probsCombined, 
        region: point, 
        scale: 1000,
        minBucketWidth: 0.1
      })
      .setSeriesNames(['Clim. prob','Condtl. prob','Fcast prob'])
      .setOptions({
        title:'Trigger Probabilities'
      })
    
    return chart ;
  
  }
  
    function chartPercentiles(point) {
  
    
    var chart =  ui.Chart.image.series({
        imageCollection: percentilesAll, 
        region: point, 
        scale: 1000,
        reducer: ee.Reducer.mean(),
        xProperty:'index_num'
      })
      .setOptions({
        title:'Climatological Percentiles',
          lineWidth: 5,
      })
    
    return chart ;
  
  }
  
  
  
  results.clear().add(chartCurrent(selected)).add(chartClim(selected));
  results2.clear().add(chartProb(selected)).add(chartPercentiles(selected));

}


