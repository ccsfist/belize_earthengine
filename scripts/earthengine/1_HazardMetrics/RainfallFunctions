
// define rainfall dataset options for subsequent functions

var rainfallDatasets = {
  'CHIRPS':ee.ImageCollection("UCSB-CHC/CHIRPS/V3/DAILY_SAT").select('precipitation'),
  'GPM':ee.ImageCollection("JAXA/GPM_L3/GSMaP/v6/operational").select(['hourlyPrecipRateGC'],['precipitation']),
  'CEMS':ee.ImageCollection("projects/climate-engine-pro/assets/ce-cems-fire-daily-4-1").select(['fire_weather_index'],['precipitation']) // fire danger index

} ;

// Create sum of rainfall over defined interval (e.g. 10 days, 2 months)

var rainfallIntervalSum = function(dataset,interval,increment,year_start,year_end,include_cap,cap_value) {
  
  // dataset: string; satellite to use ["CHIRPS","GPM"]
  // interval: integer; number of [increment] to advance by
  // increment: string; unit of time ['day','week','month']
  // year_start: integer; first calendar year for calculation
  // year_end: integer; last calendar year for calculation
  // include_cap: boolean; whether to clean data of extreme high values before summing (useful for drought)
  // cap_value: integer; cap amount in cumulative mm of rainfall IF include_cap = TRUE

  var rawData = rainfallDatasets[dataset] ;
  var years_list = ee.List.sequence(year_start,year_end) ;
  var start = '2018-01-01';
  var startDate = ee.Date(start);
  var secondDate = startDate.advance(interval, increment).millis();
  var increase = secondDate.subtract(startDate.millis());
  var interval_list = ee.List.sequence(startDate.millis(), ee.Date('2019-01-01').millis(), increase);

  if (include_cap === true) {
      rawData = rawData.map(function(image) {
        var replacement = ee.Image(cap_value) ;
        return image.where(image.gt(cap_value),replacement) ;
      }) ;
    } 

  var byInterval = ee.ImageCollection(
    ee.FeatureCollection(years_list.map(function (y) {
        var yearCollection = rawData.filter(ee.Filter.calendarRange(y, y, 'year'));
          var byYear = ee.ImageCollection.fromImages(
            interval_list.map(function (inv) {
              var summedImage = yearCollection.filter(ee.Filter.calendarRange
                (ee.Date(inv).getRelative('day','year'), 
                 ee.Date(inv).advance(interval, increment).getRelative('day','year'))
                  )
                .reduce(ee.Reducer.sum());
              
              var doy = ee.Date(inv).getRelative('day','year').add(ee.Number(1)) ;
              var moy = ee.Date(inv).getRelative('month','year').add(ee.Number(1)) ; 
              var dom = ee.Date(inv).getRelative('day','month').add(ee.Number(1)) ;
              
              return summedImage
                .set('day_of_year', doy)
                .set('year',y)
                .set('system:time_start', ee.Date.fromYMD(y, moy, dom).millis()) ;
            }));
      return byYear;
    }))
  .flatten());
    
  return byInterval ;   
  
} ;


// Start of season - first day of year in which cumulative rainfall exceeds some threshold

var onsetDate = function(intervalDataset,onsetThreshold,seasonStartDoy,seasonLength,year_start,year_end) {
  
  // intervalDataset: output from rainfallIntervalSum
  // onsetThreshold: integer; amount of cumulative rainfall in mm which defines start of season
  // seasonStartDoy: integer; day of year which defines beginning of agricultural year  
  // seasonLength: integer; number of days that the agricultural year lasts
  // year_start: integer; first calendar year for calculation
  // year_end: integer; last calendar year for calculation
  
  var years_list = ee.List.sequence(year_start,year_end) ;
  
  var onsetDataset = ee.ImageCollection(years_list.map(function (y) {
      
      var firstDoy = ee.Date.fromYMD(y,1,1) ;
      var startDate = firstDoy.advance(seasonStartDoy-1,'day') ; // start date of ag year
      var endDate = startDate.advance(seasonLength,'day') ; // end date of ag year
      
      var yearCollection = intervalDataset
          .filterDate(startDate,endDate) 
          .map(function(image) {
            
            var onset_doy = image
              .getNumber('day_of_year');
            
            var onset_image = ee.Image(onset_doy) ;
            
            var onset_image_agyear = onset_image
            .where(onset_image.lt(seasonStartDoy),onset_image.add(ee.Number(seasonLength))) ;
              
            var image_output = image
              .addBands(onset_image_agyear
              .rename('onset_date')
              .toFloat()) ;
              
              
            var image_filtered_output = image_output.updateMask(
                  image.select('precipitation_sum').gt(onsetThreshold)
                ) ;
              
              return(image_filtered_output) ;
              
          })
          .select(['onset_date'])
          .reduce(ee.Reducer.min())
          .rename(['onset_date'])
          .set('year',y) ;
          
    return yearCollection;
  })) ; 

  return onsetDataset ; 
    
} ;


// End of season - last day of year in which cumulative rainfall exceeds some threshold

