var joinProperties = ee.Filter.equals({
  leftField: 'admin_1',   // The property in the primary collection
  rightField: 'ADM1_NAME'   // The property in the secondary collection
});

var innerJoin = ee.Join.inner() ;

var date_read_function = function(feature){ // format date in EE-readable format
  
  var date = feature.get('season_date') ;
  var newdate = ee.Date.parse("YYYY-MM-dd", date) ; 
  var output_feature = feature.set('system:time_start', newdate) ; 
  return output_feature ;
  
} ;

var harvestStatProcessed = innerJoin.apply(harvestStat,adm1,joinProperties).map(function(feature) {
  // Get the primary and secondary features from the joined pair.
  var primary = ee.Feature(feature.get('primary'));
  var secondary = ee.Feature(feature.get('secondary'));

  // Merge the properties from secondary into primary and return the result.
  return secondary.set(primary.toDictionary());
}).map(date_read_function) ;

