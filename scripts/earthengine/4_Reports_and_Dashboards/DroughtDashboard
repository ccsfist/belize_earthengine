// 1. hazard metrics
  
  var rainDekadal = rainfallFunctions.rainfallIntervalSum(dataset,5,'day',year_start,year_end,true,20)  ;
  var rainTot = rainfallFunctions.seasonalTotal(rainDekadal,152,90,year_start,year_end) ;

  /// average rainfall 
  
  var rainClim = rainfallFunctions.climatology(dataset,10,'day',year_start,year_end) ;
  var rainClimTot = rainTot.mean() ;

  /// seasonal start
  
  var seasonAOnset = rainfallFunctions.onsetDate(rainDekadal,25,135,60,year_start,year_end) ;

  /// seasonal end
  
  var seasonADemise = rainfallFunctions.cessationDate(rainDekadal,25,135,60,year_start,year_end) ;

  /// season length
  
  var seasonALength = seasonAOnset.combine(seasonADemise)
    .map(function(img){
      var img_a = img.select('onset_date') ;
      var img_b = img.select('cessation_date') ;
      return img_b.subtract(img_a).rename('length').copyProperties(img_a, img_a.propertyNames()) ;
      
    }) ;
  
    var seasonALengthStats = statsFunctions.longtermStats(seasonALength,'length') ;

  // forecast
  
  /// first, convert to imageCollection

  var forecast_raw = ee.Image("projects/ee-maxmauerman/assets/belize_forecast_mu_mar") ;
  var bands = forecast_raw.bandNames() ;
  var list = bands.map(function(n) { return forecast_raw.select([n]) }) ;
  var collection = ee.ImageCollection.fromImages(list) ;
  
  /// then assign time index
  
  var timeList = ee.List.sequence(1993,2022) ;
  
  var forecast = collection.map(function(img) {
    var index = ee.Number.parse(img.get('system:index')) ;
    var selectYear = timeList.get(index) ;
    var imgFormatted = img.rename(['precip']).divide(30).set('year',ee.Number(selectYear)) ;
    
    return imgFormatted ;
    
  }).filter(ee.Filter.gte('year',year_start))
    .filter(ee.Filter.lte('year',year_end));
  

