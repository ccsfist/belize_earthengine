var fireAtlasDay = ee.ImageCollection("projects/sat-io/open-datasets/global-fire-atlas/day_of_burn") ;
var size=fireAtlasDay.size() ;
var toList = fireAtlasDay.toList(size) ;
// length + list
var idList = ee.List.sequence(0, size.subtract(1)) ;

var newList = idList.map(function(x){
  
  var index = ee.Number(idList.get(x)).add(2003) ;
  var img = toList.get(x) ;
  
  return ee.Image(img).set('id', index).copyProperties(img) ;
}) ;
var fireAtlasDay = ee.ImageCollection.fromImages(newList) ;

var fireAtlasDayUnmasked = fireAtlasDay.map(function(img){
  
  var has_fire = ee.Image(1).updateMask(img) ;
  
  return img.addBands(has_fire).unmask() ;
  
}) ;

