  //var seasonBOnset = rainfallFunctions.onsetDate(rainDekadal,40,60,90,year_start,year_end) ;
  
  /// seasonal end
  
  var seasonADemise = rainfallFunctions.cessationDate(rainDekadal,40,121,274,year_start,year_end) ;
  //var seasonBDemise = rainfallFunctions.cessationDate(rainDekadal,40,60,90,year_start,year_end) ;
  
  /// season length
  
  var seasonALength = seasonAOnset.combine(seasonADemise)
    .map(function(img){
      var img_a = img.select('onset_date') ;
      var img_b = img.select('cessation_date') ;
      return img_b.subtract(img_a).rename('length').copyProperties(img_a, img_a.propertyNames()) ;
      
    }) ;
  
