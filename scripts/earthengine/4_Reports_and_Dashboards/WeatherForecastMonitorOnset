

// load libraries

var rainfallFunctions = require('users/maxmauerman/belize_nms:1_HazardMetrics/RainfallFunctions') ;
var temperatureFunctions = require('users/maxmauerman/belize_nms:1_HazardMetrics/TemperatureFunctions') ;
var statsFunctions = require('users/maxmauerman/belize_nms:2_Statistics/StatsFunctions') ;
var projectionFunctions = require('users/maxmauerman/belize_nms:2_Statistics/ProjectionFunctions') ;
var arealFunctions = require('users/maxmauerman/belize_nms:3_ArealSummary/SpatialAvgFunctions') ;


var muni = ee.FeatureCollection('WM/geoLab/geoBoundaries/600/ADM2').filter(ee.Filter.eq("shapeGroup","BLZ")) ;

var monitor_year = ee.Number(ui.url.get('year',2025)) ;
var monitor_month = ee.Number(ui.url.get('year',5)) ;
var monitor_day = ee.Number(ui.url.get('year',1)) ;

var monitor_date = ee.String(monitor_year).cat("/").cat(ee.String(monitor_month))
  .cat("/").cat(ee.String(monitor_day))
  
var monitor_date = ee.Date.parse("YYYY/MM/dd",monitor_date)

// Get precip forecasts created on this date
var forecasts = ee.ImageCollection('NOAA/GFS0P25')
                    .filter(ee.Filter.date(monitor_date))
                    .select('precipitation_rate')
                    .sort('forecast_hours');

var forecastRange = forecasts.reduceColumns(ee.Reducer.minMax(), ["forecast_time"]) ;
var forecastFirst = forecastRange.get('min') ;
var forecastLast = forecastRange.get('max') ;

var interval = 5;
var increment = 'day';

var windowStartDate = ee.Date(forecastFirst) ; 
var windowEndDate = ee.Date(forecastLast) ;
var secondWindowDate = windowStartDate.advance(interval, increment).millis();

var windowIncrease = secondWindowDate.subtract(windowStartDate.millis());
var window_list = ee.List.sequence(windowStartDate.millis(),
    windowEndDate.millis(), windowIncrease);

// Chart the total forecasted precip for all of Belize over the next 15
// days.

forecasts = forecasts.map(function(img) {
  
  var hours = ee.Number(img.get('forecast_hours'))
  
  var isLonger = hours.gte(120)
  
  var imgScaled = img.where(isLonger,img.multiply(3)).multiply(3600) ;
  
  return imgScaled.copyProperties(img)
  
})

var belize = ee.FeatureCollection('WM/geoLab/geoBoundaries/600/ADM0')
                .filter(ee.Filter.eq('shapeName', 'Belize'))
                .first()
                .geometry();


// Also display the total precip forecast 
Map.centerObject(belize);
Map.addLayer(
    forecasts.sum().clip(belize), {
      min: 10,
      max: 200,
      palette: ['blue', 'green', 'yellow', 'orange', 'red'],
    },
    'total 15-day precip',false);
    
    
// compute daily totals


var byWindow = ee.ImageCollection.fromImages(
      window_list.map(function(date) {

        var firstDate = ee.Date(date).millis()
        var lastDate = ee.Date(date).advance(interval, increment).millis()

        var total = forecasts
        .filter(ee.Filter.rangeContains('forecast_time',firstDate,lastDate))
        .sum()
        
        return total
            .set('date',date);
}));



// compute onset (first day above threshold)

var onsetThreshold = 25 ; 

var onset = byWindow
          .map(function(image) {
            
            var date = image
              .get('date');
            
            var doy = ee.Date(date).getRelative('day','year') ;
            
            var onset_image = ee.Image(doy) ;
            
            var image_output = image
              .addBands(onset_image
              .rename('onset_date')
              .toFloat()) ;
              
              
            var image_filtered_output = image_output.updateMask(
                  image.select('precipitation_rate').gt(onsetThreshold)
                ) ;
              
              return(image_filtered_output) ;

          }).select(['onset_date'])
          .reduce(ee.Reducer.min())
          .rename(['onset_date'])
          
Map.addLayer(
    onset.clip(belize), {
      min: 152,
      max: 163,
      palette: ['blue', 'green', 'yellow', 'orange', 'red'],
    },
    'Forecasted onset date',false);

// compute whether it's past danger threshold or not 

var thresh = 150 ;
var zero = ee.Image(0) ;
var two = ee.Image(2) ;

var crossesThresh = zero.where(onset.gt(thresh),two).updateMask(onset)
  .unmask(ee.Image(1))

Map.addLayer(
    crossesThresh.clip(belize), {
      min: 0,
      max: 2,
      palette: ['blue','yellow','red'],
    },
    'Past danger threshold?');



/// exposure 
  
  
