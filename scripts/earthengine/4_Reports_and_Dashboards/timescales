/// map

var visCompiled = ee.Image([rSquareAdj,rSquareAdjDecadal])
  .rename(['trend','decadal']);

var visCompiled = visCompiled.addBands(ee.Image(1)
  .subtract(visCompiled.select('trend'))
  .subtract(visCompiled.select('decadal'))
  .rename('interannual')) ;
  
