// EMDAT
/// nb - filter by country (e.g.) first to speed up computation time 

var emdat = ee.FeatureCollection('projects/tetratechmm/assets/EMDAT')
  .filter(ee.Filter.eq('Country','Zambia')) ; // change as needed
var gaul_adm0 = ee.FeatureCollection("FAO/GAUL_SIMPLIFIED_500m/2015/level0") ;
var gaul_adm1 = ee.FeatureCollection("FAO/GAUL_SIMPLIFIED_500m/2015/level1") ;
var gaul_adm2 = ee.FeatureCollection("FAO/GAUL_SIMPLIFIED_500m/2015/level2") ;

var emdat_adm1 = emdat.filter(ee.Filter.inList('Adm Level',ee.List(['1'])))
    .filter(ee.Filter.notEquals('Start Month',null));
var emdat_adm1_nomonth = emdat.filter(ee.Filter.inList('Adm Level',ee.List(['1'])))
    .filter(ee.Filter.eq('Start Month',null))
    .map(function(feat){
      return feat.set('Start Month',1) ;
    });  
var emdat_adm1_merged = emdat_adm1.merge(emdat_adm1_nomonth) ;

var emdat_adm2 = emdat.filter(ee.Filter.inList('Adm Level',ee.List(['1;2','2'])))
    .filter(ee.Filter.notEquals('Start Month',null)) ;
var emdat_adm2_nomonth = emdat.filter(ee.Filter.inList('Adm Level',ee.List(['1;2','2'])))
    .filter(ee.Filter.eq('Start Month',null))
    .map(function(feat){
      return feat.set('Start Month',1) ;
    });    
var emdat_adm2_merged = emdat_adm2.merge(emdat_adm2_nomonth) ;

var gaul_countries = gaul_adm0.aggregate_array('ADM0_NAME').distinct() ;
var emdat_adm0 = emdat.filter(ee.Filter.eq('Adm Level',''))
  .filter(ee.Filter.notEquals('Start Month',null))
  .filter(ee.Filter.inList('Country',gaul_countries)) ;

var emdat_adm0_nomonth = emdat.filter(ee.Filter.eq('Adm Level',''))
  .filter(ee.Filter.eq('Start Month',null))
  .filter(ee.Filter.inList('Country',gaul_countries))
  .map(function(feat){
      return feat.set('Start Month',1) ;
    });  
var emdat_adm0_merged = emdat_adm0.merge(emdat_adm0_nomonth) ;

var emdat_adm1 = emdat_adm1_merged.map(function(feat) {
  
  var adminList = ee.String(feat.get('Admin1 Code')).split(';')
  .map(function (string) { return ee.Number.parse(string)});
  
  var gaul_selected = gaul_adm1
    .filter(ee.Filter.inList('ADM1_CODE',adminList)) ;
  
  var year = feat.get('Start Year') ;
  var month = feat.get('Start Month') ;
  
  return feat
    .set('start_date',ee.Date.fromYMD(year,month,1))
    .setGeometry(gaul_selected.geometry().simplify(1000)) ;
  
}) ;

var emdat_adm2 = emdat_adm2_merged.map(function(feat) {
  
  var adminList = ee.String(feat.get('Admin2 Code')).split(';')
  .map(function (string) { return ee.Number.parse(string)});
  
  var gaul_selected = gaul_adm2
    .filter(ee.Filter.inList('ADM2_CODE',adminList)) ;
  
  var year = feat.get('Start Year') ;
  var month = feat.get('Start Month') ;
  
  return feat
    .set('start_date',ee.Date.fromYMD(year,month,1))
    .setGeometry(gaul_selected.geometry().simplify(1000)) ;
  
}) ;

var emdat_adm0 = emdat_adm0_merged.map(function(feat) {
  
  var admin = ee.String(feat.get('Country')) ;
  var gaul_selected = gaul_adm0
    .filter(ee.Filter.eq('ADM0_NAME',admin)) ;
  
  var year = feat.get('Start Year') ;
  var month = feat.get('Start Month') ;
  
  return feat
    .set('start_date',ee.Date.fromYMD(year,month,1))
    .setGeometry(gaul_selected.geometry().simplify(1000)) ;
  
}) ;

var emdat_adm2_selected = emdat_adm2.map(function(feat){
  return feat.set('selected',feat.intersects(study_area.bounds(),1000)) ;
}).filter(ee.Filter.eq('selected',true)) ;

var emdat_adm1_selected = emdat_adm1.map(function(feat){
  return feat.set('selected',feat.intersects(study_area.bounds(),1000)) ;
}).filter(ee.Filter.eq('selected',true)) ;

var emdat_adm0_selected = emdat_adm0 ;

var emdat_all = emdat_adm2_selected.merge(emdat_adm1_selected).merge(emdat_adm0_selected) ;

var max_emdat = ee.Number(emdat_all.aggregate_max('Total Affected')) ;



var emdatChart = ui.Chart.feature
  .groups({
