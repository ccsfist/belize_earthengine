  /// chart functions
  
 function emdatChart() {
    
    var study_area = muni.filterBounds(ee.Geometry.MultiPoint(selectedPoints)) ;
    
    var gaul_adm1 = ee.FeatureCollection("FAO/GAUL_SIMPLIFIED_500m/2015/level1")
      .filter(ee.Filter.eq("ADM0_NAME","Belize"));
    var gaul_adm2 = ee.FeatureCollection("FAO/GAUL_SIMPLIFIED_500m/2015/level2")
     .filter(ee.Filter.eq("ADM0_NAME","Belize"));
    
    var emdat = ee.FeatureCollection("projects/sat-io/open-datasets/gdis_1960-2018")
      .filter(ee.Filter.eq('country','Belize')) ; // change as needed
    
    var emdat_coded = emdat.map(function(feat) {
      
      var yearString = feat.getString('year') ;
      var levelString = feat.getString('level') ;
      
      var yearVal = ee.Number.parse(yearString) ;
      var levelVal = ee.Number.parse(levelString) ;
      
      return feat.set('year',yearVal).set('level',levelVal)
      
    }) ;
    
    var emdat_adm1 = emdat_coded.filter(ee.Filter.eq('level',1)) ;
    var emdat_adm2 = emdat_coded.filter(ee.Filter.eq('level',2)) ;
    var emdat_adm3 = emdat_coded.filter(ee.Filter.eq('level',3)) ;
    
    var adm1_clicked = gaul_adm1.map(function(feat){
      return feat.set('selected',feat.intersects(study_area.geometry(),1000)) ;
    }).filter(ee.Filter.eq('selected',true)) ;
    
    var adm2_clicked = gaul_adm2.map(function(feat){
      return feat.set('selected',feat.intersects(study_area.geometry(),1000)) ;
    }).filter(ee.Filter.eq('selected',true)) ;
    
    var emdat_adm1_selected = emdat_adm1.map(function(feat){
      return feat.set('selected',feat.intersects(adm1_clicked.geometry(),1000)) ;
    }).filter(ee.Filter.eq('selected',true)) ;

    var emdat_adm2_selected = emdat_adm2.map(function(feat){
      return feat.set('selected',feat.intersects(adm2_clicked.geometry(),1000)) ;
    }).filter(ee.Filter.eq('selected',true)) ;

    var emdat_adm3_selected = emdat_adm3.map(function(feat){
      return feat.set('selected',feat.intersects(adm2_clicked.geometry(),1000)) ;
    }).filter(ee.Filter.eq('selected',true)) ;

    var emdat_all = emdat_adm3_selected
      .merge(emdat_adm2_selected)
      .merge(emdat_adm1_selected) ;
    
    var chart = ui.Chart.feature
      .groups({
        features: emdat_all.filter(ee.Filter.gte('year',year_start)).filter(ee.Filter.lte('year',year_end)),
        xProperty: 'year',
        yProperty: 'level',
        seriesProperty: 'disasterty'
      })
      .setChartType('ScatterChart')
      .setOptions({
        title: "EMDAT disaster events",
       hAxis:{
        title: 'Year',
        viewWindow: {min:year_start,max:year_end}
      }  
      }) ;
    return chart ;
    
  }
  
  function hazardChart() {
    
    var selectedMuni = muni.filterBounds(ee.Geometry.MultiPoint(selectedPoints)) ;
    
    var startDate = ee.Date.fromYMD(year_start+1,1,1);
    var endDate = ee.Date.fromYMD(year_end+1,1,1) ;
    var secondDate = startDate.advance(1, 'year').millis();
    var increase = secondDate.subtract(startDate.millis());
    var interval_list = ee.List.sequence(startDate.millis(), endDate.millis(), increase) ;
    
   var chart = ui.Chart.feature.byFeature({
      features: storms.filterBounds(selectedMuni), 
      xProperty: 'system:time_start',
      yProperties: "USA_SSHS"
    }).setOptions({
      lineWidth: 0,
      pointSize: 5,
      title: 'Storms Making Landfall',
      vAxis: {title: 'Storm Category'},
      hAxis: {title: 'Year', ticks: interval_list.getInfo()}
    }) ;
    
    return chart ;
    
  }

