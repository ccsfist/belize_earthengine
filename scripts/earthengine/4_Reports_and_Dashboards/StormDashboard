  function climChartBadYears() {
        
        var selectedMuni = muni.filterBounds(ee.Geometry.MultiPoint(selectedPoints)) ;
        
        var years_toselect = storms
          .filterBounds(selectedMuni)
          .aggregate_array('year')
          .distinct() ;
        
        var chart = ui.Chart.image.doySeriesByYear({
          imageCollection: rainDekadal.filter(ee.Filter.inList('year',years_toselect)), 
          bandName: 'precipitation_sum',
          region: selectedMuni, 
          regionReducer: ee.Reducer.mean(), 
          scale: 10000
        }).setOptions({
          title: 'Rainfall in storm years',
          vAxis: {title: '10-day mm'},
          hAxis: {title: 'Day of year'}
        }) ;
        
        return chart ;
    
      }


   function climPctilesChart() {
    
    var selectedMuni = muni.filterBounds(ee.Geometry.MultiPoint(selectedPoints)) ;
    
    var percentilesAll = rainMax.reduce(ee.Reducer.percentile(ee.List.sequence(10,100,10))) ;
    
    var bands = percentilesAll.bandNames()
    var list = bands.map(function(n) { return percentilesAll.select([n]) })
    var percentilesAll = ee.ImageCollection.fromImages(list).map(function(n){
      var index = n.get('system:index')
      return n.set('index_num',ee.Number(index))
    }) ;
    
    
    var chart =  ui.Chart.image.series({
        imageCollection: percentilesAll, 
        region: selectedMuni, 
        scale: 10000,
        reducer: ee.Reducer.mean(),
        xProperty:'index_num'
      })
      .setOptions({
        title:'Climatological Percentiles of Max Rainfall',
          lineWidth: 5,
      })
    
    return chart ;

  }

  // Creates a color bar thumbnail image for use in legend from the given color
